          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "places": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Places"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          },
          "date_ranges": {
            "items": {
              "additionalProperties": {
