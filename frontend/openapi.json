          },
          "credit": {
            "type": "string",
            "title": "Credit"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          }
        },
        "type": "object",
        "required": [
          "record_uid",
          "image_uid",
          "title",
          "description",
          "date",
          "maker",
          "catalogue_identifiers",
          "licence",
          "copyright",
          "credit",
          "source_url"
        ],
        "title": "AssociationRead"
      },
      "Body_search_image": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 24
          },
          "date_from": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9999.0,
                "minimum": -9999.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9999.0,
                "minimum": -9999.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To"
          },
          "place": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Place"
