GEMINI_API_KEY=your-key-here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
# Replace these placeholders with your Qdrant cluster endpoint and API key.
QDRANT_URL=https://your-cluster-endpoint:6333
QDRANT_API_KEY=your-qdrant-api-key
# Reuse one collection across indexing runs. Omit for separate collections per run.
QDRANT_COLLECTION_NAME=smg_images
# For local Docker, use QDRANT_URL=http://127.0.0.1:6333 and QDRANT_API_KEY=
SQLITE_PATH=data/search/catalog.sqlite3
# The local embedding cache lives beside SQLITE_PATH as embedding_cache.sqlite3.
