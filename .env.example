# Shared retrieval settings for HF search, web search, Codex tools and indexing.
# Point both deployments at one Qdrant collection and its matching PostgreSQL
# catalogue; use the same model/revision/dimensions and HF image release.
# Search runs SigLIP 2 locally; no provider API key is needed.
EMBEDDING_MODEL=google/siglip2-base-patch16-224
EMBEDDING_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL_CACHE=data/models
EMBEDDING_CPU_THREADS=2
EMBEDDING_BATCH_SIZE=8
# Replace these placeholders with your Qdrant cluster endpoint and API key.
# Cloud REST supports 443; include it explicitly for the Python client's URL.
QDRANT_URL=https://your-cluster-endpoint:443
QDRANT_API_KEY=your-qdrant-api-key
# Must match the active PostgreSQL catalogue's collection in both editions.
# Reuse one collection across indexing runs. Omit for separate collections per run.
QDRANT_COLLECTION_NAME=smg_images_siglip2
# For local Docker, use QDRANT_URL=http://127.0.0.1:6333 and QDRANT_API_KEY=
SEARCH_DATA_DIR=data/search
# Collection images: read-only HF bucket mounted at IMAGE_ROOT in a Space.
# Local development uses the extracted files at the same relative paths.
IMAGE_ROOT=data/images
# Neon supplies these through `bun run neon link` / `bun run neon env pull` in .env or .env.local.
# DATABASE_URL is required for the app and indexing; the catalogue uses PostgreSQL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# HF search: neon_http uses Neon's HTTPS /sql endpoint on 443 with DATABASE_URL.
# Keep the original PostgreSQL URL (port 5432). Web/Studio/local use postgres.
# Run make migrate before serving; indexing also applies catalogue migrations.
CATALOGUE_TRANSPORT=postgres
# The local SQLite embedding cache is SEARCH_DATA_DIR/embedding_cache.sqlite3.
# Logfire also reads the ignored .logfire/ credentials created by its setup CLI.
LOGFIRE_TOKEN=
# Indexing uses its own project credentials in .logfire/indexer/ or this token.
LOGFIRE_INDEXER_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_ENVIRONMENT=development

# Web edition only: make web / Docker --build-arg EDITION=web.
# Register an HF OAuth app with this exact callback URL:
# http://127.0.0.1:8000/api/v1/explorer/auth/callback
# Use the public HTTPS origin in production; Vite development uses port 5173.
EXPLORER_PUBLIC_URL=http://127.0.0.1:8000
EXPLORER_GATEWAY_URL=http://127.0.0.1:8000
EXPLORER_OAUTH_CLIENT_ID=
EXPLORER_OAUTH_CLIENT_SECRET=
# Generate independently of provider credentials, at least 32 random characters.
EXPLORER_SESSION_SECRET=
EXPLORER_API_KEY=
# Choose an image-capable Codex model available to the API key.
EXPLORER_MODEL=
# Private durable volume: user uploads and resumable Codex thread state.
EXPLORER_STATE_DIR=data/explorer
EXPLORER_MAX_CONCURRENT=2
EXPLORER_RUN_TIMEOUT=180
EXPLORER_MAX_TOOL_CALLS=20
EXPLORER_MAX_TURNS=30

# Image Studio prototype (make studio; separate from both release editions).
AGENT_ENABLED=false
# Set a random value of at least 32 characters; never reuse a provider API key here.
AGENT_ACCESS_TOKEN=
AGENT_WORKSPACE=default
AGENT_ENVIRONMENT=development
# Local profile preparation/testing only. Production uses PostgreSQL + a private HF bucket.
AGENT_DATABASE_URL=sqlite:///data/agent/agent.sqlite3
AGENT_STORAGE=local
# For cloud agent assets, set AGENT_STORAGE=hf and supply these secrets/settings.
AGENT_HF_BUCKET=
AGENT_HF_TOKEN=
# Same-container gateway; app.space sets this to its listening port automatically.
# For a manually started API/worker pair, match the API port here.
AGENT_GATEWAY_URL=http://127.0.0.1:8000
# Install the backend's agent extra before enabling chat or Image Studio.
# An OpenAI-compatible endpoint must support structured Chat Completions and image inputs.
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.openai.com/v1
# Choose a model available at that endpoint; chat/evaluation default to AGENT_MODEL.
AGENT_MODEL=
AGENT_EVALUATION_MODEL=
# Gemini is used only for image generation.
GEMINI_API_KEY=
AGENT_IMAGE_MODEL=gemini-3.1-flash-image
# Use the Logfire API origin associated with your project's region.
AGENT_LOGFIRE_API_URL=https://logfire-api.pydantic.dev

# Conversation backend; DATABASE_URL supplies the shared catalogue by default.
AGENT_CHAT_MODEL=
# Optional legacy SQLite snapshot for UUID lookup; omit to use PostgreSQL.
# AGENT_COLLECTION_DATABASE=/absolute/path/to/data/search/catalog.sqlite3
# Defaults to IMAGE_ROOT, then data/images; point it at mounted collection images.
# AGENT_COLLECTION_IMAGE_ROOT=/absolute/path/to/data/images

# Optional trusted online API for image UUID lookup; record IDs still require DATABASE_URL.
# AGENT_COLLECTION_API_URL=https://your-collection-api.example
# AGENT_COLLECTION_API_TOKEN=
