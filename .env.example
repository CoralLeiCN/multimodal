GEMINI_API_KEY=your-key-here
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536
# Replace these placeholders with your Qdrant cluster endpoint and API key.
QDRANT_URL=https://your-cluster-endpoint:6333
QDRANT_API_KEY=your-qdrant-api-key
# Reuse one collection across indexing runs. Omit for separate collections per run.
QDRANT_COLLECTION_NAME=smg_images_d7af4d4835314fe0
# For local Docker, use QDRANT_URL=http://127.0.0.1:6333 and QDRANT_API_KEY=
SEARCH_DATA_DIR=data/search
# Neon supplies these through `bun run neon link` / `bun run neon env pull` in .env or .env.local.
# DATABASE_URL is required for the app and indexing; the catalogue uses PostgreSQL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# The local SQLite embedding cache is SEARCH_DATA_DIR/embedding_cache.sqlite3.
# Logfire also reads the ignored .logfire/ credentials created by its setup CLI.
LOGFIRE_TOKEN=
# Indexing uses its own project credentials in .logfire/indexer/ or this token.
LOGFIRE_INDEXER_TOKEN=
LOGFIRE_SEND_TO_LOGFIRE=if-token-present
LOGFIRE_ENVIRONMENT=development

# Image Studio (independent of collection search).
AGENT_ENABLED=false
# Set a random value of at least 32 characters; never use the Gemini key here.
AGENT_ACCESS_TOKEN=
AGENT_WORKSPACE=default
AGENT_ENVIRONMENT=development
# Local profile preparation/testing only. Cloud deployments require PostgreSQL + S3.
AGENT_DATABASE_URL=sqlite:///data/agent/agent.sqlite3
AGENT_STORAGE=local
AGENT_S3_BUCKET=
AGENT_S3_REGION=eu-west-2
# Optional S3-compatible endpoint; AWS credentials use the standard credential chain.
# AGENT_S3_ENDPOINT=https://your-object-storage-endpoint
# Origin only, with no path. Must be reachable from Modal over HTTPS.
AGENT_GATEWAY_URL=
AGENT_MODAL_APP=multimodal-agent
AGENT_MODEL=gemini-3.8-flash
AGENT_EVALUATION_MODEL=gemini-3.8-flash
AGENT_IMAGE_MODEL=gemini-3.1-flash-image
# Use the Logfire API origin associated with your project's region.
AGENT_LOGFIRE_API_URL=https://logfire-api.pydantic.dev

# Conversation backend; catalogue paths are read-only inputs to the trusted gateway.
AGENT_CHAT_MODEL=gemini-3.8-flash
# Defaults resolve inside this worktree. Use absolute paths to share an existing catalogue.
# AGENT_COLLECTION_DATABASE=/absolute/path/to/data/search/catalog.sqlite3
# AGENT_COLLECTION_IMAGE_ROOT=/absolute/path/to/data/images

# Optional trusted online collection API; when set, it replaces local catalogue lookup.
# AGENT_COLLECTION_API_URL=https://your-collection-api.example
# AGENT_COLLECTION_API_TOKEN=
